generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Level {
  L3
  L4
  L5
  L6
  SDE_I @map("SDE-I")
  SDE_II @map("SDE-II")
  SDE_III @map("SDE-III")
  Staff
  Principal
}

model Salary {
  id                 String   @id @default(cuid())
  company            String
  normalized_company String
  role               String
  level_standardized Level
  location           String
  experience_years   Int
  base_salary        Int
  bonus              Int
  stock              Int
  total_compensation Int
  confidence_score   Float
  created_at         DateTime @default(now())

  @@index([normalized_company])
  @@index([level_standardized])
  @@index([location])
  @@index([total_compensation])
}
